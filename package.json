{
  "name": "knowweave",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KnWeave 知织 —— 以事实为中心的个人 AI 知识库（Node.js 主服务）",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "migrate": "tsx scripts/migrate.ts",
    "sidecar": "knowweave/.venv/bin/python -m uvicorn sidecar.main:app --host 127.0.0.1 --port 8732",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "eval:offline": "node --import tsx scripts/evaluate.ts",
    "eval:live": "node --import tsx scripts/evaluate.ts --live",
    "test:browser": "node --import tsx scripts/browser-smoke.ts",
    "test:sidecar": "knowweave/.venv/bin/python -m unittest sidecar.test_parsing sidecar.test_models",
    "sync:directory": "node --import tsx scripts/sync-directory.ts",
    "repair:facts": "tsx scripts/repair-facts.ts"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.2-alpha.3",
    "@deepseek-ai/libreoffice-kit": "0.1.5",
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.2.0",
    "@fastify/websocket": "^11.3.7",
    "fastify": "^5.2.1",
    "kysely": "^0.27.6",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.13.1",
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
